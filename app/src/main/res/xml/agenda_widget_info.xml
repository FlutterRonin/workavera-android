<?xml version="1.0" encoding="utf-8"?>
<!--
  Agenda widget: 4x2 by default (one line per item), resizable taller for the
  two-line layout with date badges. Refreshes every 30 minutes, like the iOS
  widget; the app and the refresh button update it in between.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.workavera.android.widget.AgendaWidgetConfigureActivity"
    android:description="@string/agenda_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="220dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/agenda_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
