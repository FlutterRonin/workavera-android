<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample shown in the widget picker (Android 12+), like the iOS gallery entry. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/agenda_widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/agenda_widget_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_today"
            android:textColor="@color/agenda_widget_today"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/agenda_widget_button_chat"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_widget_sparkles"
            android:tint="@color/agenda_widget_chat" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/agenda_widget_button_neutral"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/agenda_widget_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_today"
            android:textColor="@color/agenda_widget_today"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:background="#3B82F6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_standup"
            android:textColor="@color/agenda_widget_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="@color/agenda_widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_today"
            android:textColor="@color/agenda_widget_today"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:background="#8B5CF6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_design"
            android:textColor="@color/agenda_widget_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:00"
            android:textColor="@color/agenda_widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_tomorrow"
            android:textColor="@color/agenda_widget_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:background="#F59E0B" />

        <ImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_task"
            android:tint="@color/agenda_widget_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_review"
            android:textColor="@color/agenda_widget_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_tomorrow"
            android:textColor="@color/agenda_widget_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:background="#F59E0B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agenda_widget_sample_dinner"
            android:textColor="@color/agenda_widget_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19:00"
            android:textColor="@color/agenda_widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
