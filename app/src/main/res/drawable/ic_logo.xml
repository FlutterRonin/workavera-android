<?xml version="1.0" encoding="utf-8"?>
<!-- Workavera 品牌 logo：圆弧 W + 悬浮光点 + 落地投影，路径与 iOS Logo.imageset 的 SVG 一致。
     笔画颜色随主题切换（见 values / values-night 的 logo_body）。

     投影在 SVG 里是 skewX(-46) scale(1 .2) 的仿射变换，而 VectorDrawable 的 group
     只支持 translate / scale / rotate，因此投影路径的坐标已预先算好写死；
     笔宽同理无法被非等比缩放，取 1.9 近似（真实值在 0.6~2.1 之间变化）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">

    <!-- 落地投影 -->
    <path
        android:strokeColor="@color/logo_body"
        android:strokeWidth="1.9"
        android:strokeAlpha="0.28"
        android:strokeLineCap="round"
        android:pathData="M8.87,22.3C8.23,24.2 9.26,25.1 11.23,25.1C13.21,25.1 17.48,23.39 18.08,23.39C18.68,23.39 19.41,25.1 21.39,25.1C23.36,25.1 26.27,24.2 29.55,22.3" />
    <path
        android:fillColor="@color/logo_body"
        android:fillAlpha="0.28"
        android:pathData="M17.47,21.98a2.07,0.41 0 1,0 4.14,0a2.07,0.41 0 1,0 -4.14,0Z" />

    <!-- 主体 -->
    <path
        android:strokeColor="@color/logo_body"
        android:strokeWidth="3.01"
        android:strokeLineCap="round"
        android:pathData="M5.66,9.89C6.98,19.38 8.95,23.9 10.92,23.9C12.9,23.9 15.4,15.35 16,15.35C16.6,15.35 19.1,23.9 21.08,23.9C23.05,23.9 25.02,19.38 26.34,9.89" />
    <path
        android:fillColor="@color/logo_body"
        android:pathData="M13.93,8.29a2.07,2.07 0 1,0 4.14,0a2.07,2.07 0 1,0 -4.14,0Z" />
</vector>
