# Copy to keystore.properties and fill in. That file is git-ignored: it holds
# the passwords to your signing key, and losing control of the key means
# losing the ability to ship updates to anyone who installed the app.
#
# Generate the key first (choose your own passwords when prompted):
#
#   keytool -genkeypair -v \
#     -keystore workavera-release.jks \
#     -alias workavera \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep workavera-release.jks and these passwords backed up somewhere safe.
# Play accepts updates only when they are signed with the same key.

storeFile=workavera-release.jks
storePassword=
keyAlias=workavera
keyPassword=
